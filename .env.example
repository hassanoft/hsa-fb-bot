# =============================================================
# H$Λ BOT — Configuration d'environnement (version Facebook)
# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne mettez JAMAIS de vraies clés dans ce fichier .env.example.
# =============================================================

# ---- Identité du bot ----
BOT_NAME=H$Λ BOT
PREFIX=/

# ---- Session Facebook (compte personnel automatisé) ----
# Chemin vers le fichier de session (cookies), voir account.json et le README.
ACCOUNT_JSON_PATH=./account.json
# Alternative pour les hébergeurs sans upload de fichier (ex: Render) : collez
# ici le JSON brut de la session ; il sera écrit dans ACCOUNT_JSON_PATH au
# démarrage. Laissez vide si vous fournissez déjà account.json directement.
ACCOUNT_JSON=

# ---- Propriétaire (OWNER) ----
# Identifiant numérique Facebook du propriétaire (PAS le compte automatisé
# par le bot lui-même — voir le README, section Propriétaire).
OWNER_ID=

# ---- Fil pour /videostatus (optionnel) ----
# Facebook n'a pas d'équivalent fiable au "Statut" WhatsApp via ce mécanisme.
# Renseignez ici l'identifiant d'un fil/groupe Facebook pour que
# /videostatus puisse y publier des vidéos.
FB_STATUS_THREAD_ID=

# ---- Serveur HTTP (Render) ----
PORT=3000

# ---- Stockage / persistance ----
DATA_DIR=./data

# ---- Intelligence Artificielle (/ai /ask /chat /translate /summarize ...) ----
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Génération d'image (/imagine)
AI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
AI_IMAGE_MODEL=dall-e-3

# Synthèse vocale (/tts)
TTS_API_URL=
TTS_API_KEY=

# ---- Image ----
REMOVEBG_API_KEY=
REMOVEBG_API_URL=https://api.remove.bg/v1.0/removebg
IMAGE_UPSCALE_API_URL=
IMAGE_UPSCALE_API_KEY=

# ---- Téléchargement (yt / tiktok / instagram / facebook / twitter) ----
DOWNLOAD_API_URL=
DOWNLOAD_API_KEY=

# ---- Météo (/weather) ----
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# ---- Devises (/currency) ----
CURRENCY_API_URL=https://api.exchangerate.host/latest

# ---- Modération : anti-NSFW (/antinsfw) ----
NSFW_API_URL=
NSFW_API_KEY=

# ---- FFmpeg ----
FFMPEG_PATH=

# ---- Divers ----
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=10000
